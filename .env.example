# Runtime
APP_ENV=development
TZ=Asia/Karachi

# Jazz
JAZZ_URL=https://businessline.jazz.com.pk/Businessvpbx/admin/vpbxadmin
JAZZ_UAN=
JAZZ_PASSWORD=
JAZZ_HEADLESS=true
JAZZ_SYNC_OVERLAP_MINUTES=30
JAZZ_PAGE_TIMEOUT_MS=30000
JAZZ_MAX_PAGES=200

# Scheduling
# Appwrite schedules are UTC and recorded in appwrite.config.json.
BUSINESS_DAY_START=09:30
BUSINESS_DAY_END=18:00
APP_TIMEZONE=Asia/Karachi

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSCRIBE_FALLBACK_MODEL=gpt-transcribe
OPENAI_GRADING_MODEL=gpt-6-sol
OPENAI_ROMANIZER_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3

# Product vocabulary hints (comma separated, configurable)
PRODUCT_KEYWORDS=Yousuf Rice,Super Kernel Basmati,IRRI-6,1121 Kainat,5kg,10kg,20kg,50kg sack

# Retention
AUDIO_RETENTION_DAYS=15
DEBUG_ARTIFACT_RETENTION_DAYS=7

# Appwrite server config (backend only — NEVER expose to browser)
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=call_grader
APPWRITE_RECORDINGS_BUCKET_ID=call_recordings

# Public browser-safe Appwrite values only
NEXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Next.js server-side login: separate key with only sessions.write scope
APPWRITE_AUTH_API_KEY=
# Optional exact public site origin for sign-in/sign-out CSRF checks
APP_ORIGIN=

# Private Functions + Sites connection (the deployment helper sets these)
INTERNAL_API_TOKEN=
APPWRITE_BACKEND_FUNCTION_ID=call-grader-api

# Worker
WORKER_LEASE_SECONDS=1200
JOB_MAX_ATTEMPTS=6
JOB_RETRY_COOLDOWN_SECONDS=1800

# Reporting
LOW_SCORE_THRESHOLD=6.0

# Playwright state
PLAYWRIGHT_STATE_DIR=/tmp/yousuf-playwright-state
DEBUG_ARTIFACT_DIR=/tmp/yousuf-debug-artifacts
LOCAL_AUDIO_DIR=/tmp/yousuf-audio
