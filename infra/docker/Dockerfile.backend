FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl \
  && rm -rf /var/lib/apt/lists/*
RUN useradd -m app
WORKDIR /srv/backend
COPY services/backend/pyproject.toml services/backend/uv.lock ./
RUN pip install --no-cache-dir uv && uv sync --frozen --no-dev
ENV PATH="/srv/backend/.venv/bin:$PATH"
COPY services/backend/app ./app
COPY scripts /srv/scripts
USER app
EXPOSE 8000
CMD ["sh", "-c", "if [ \"$SERVICE_ROLE\" = \"scheduler\" ]; then python -m app.jobs.scheduler; elif [ \"$SERVICE_ROLE\" = \"worker\" ]; then python -m app.jobs.worker; else uvicorn app.main:app --host 0.0.0.0 --port 8000; fi"]
