FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /srv/backend
COPY services/backend/pyproject.toml services/backend/uv.lock ./
RUN pip install --no-cache-dir uv && uv sync --frozen --no-dev
ENV PATH="/srv/backend/.venv/bin:$PATH"
RUN python -m playwright install --with-deps chromium
COPY services/backend/app ./app
COPY scripts /srv/scripts
EXPOSE 8000
CMD ["sh", "-c", "if [ \"$SERVICE_ROLE\" = \"scheduler\" ]; then python -m app.jobs.scheduler; elif [ \"$SERVICE_ROLE\" = \"api\" ]; then uvicorn app.main:app --host 0.0.0.0 --port 8000; else python -m app.jobs.worker; fi"]
